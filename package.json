{
  "name": "@ribrewguy/nuxt-openfeature",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ribrewguy/nuxt-openfeature.git"
  },
  "homepage": "https://github.com/ribrewguy/nuxt-openfeature#readme",
  "bugs": {
    "url": "https://github.com/ribrewguy/nuxt-openfeature/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs"
    },
    "./runtime/*": "./dist/runtime/*"
  },
  "scripts": {
    "dev": "pnpm --dir playground dev",
    "docs:dev": "pnpm --dir docs dev",
    "docs:lint": "pnpm exec eslint docs --config eslint.config.mjs",
    "docs:typecheck": "pnpm --dir docs typecheck",
    "docs:build": "pnpm --dir docs build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "unbuild",
    "prepack": "pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky",
    "secrets:scan": "gitleaks-secret-scanner --diff-mode staged --redact --no-banner",
    "secrets:scan:full": "gitleaks-secret-scanner --diff-mode history --redact --no-banner"
  },
  "peerDependencies": {
    "@openfeature/flagsmith-provider": "^0.1.2",
    "@openfeature/server-sdk": "^1.20.1",
    "@tanstack/vue-query": "^5.0.0",
    "@vercel/flags-core": "^1.4.0",
    "flagsmith-nodejs": "^6.2.0",
    "nuxt": "^4.0.0",
    "posthog-node": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@openfeature/flagsmith-provider": {
      "optional": true
    },
    "@vercel/flags-core": {
      "optional": true
    },
    "flagsmith-nodejs": {
      "optional": true
    },
    "posthog-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@nuxt/kit": "^4.4.6",
    "@nuxt/test-utils": "^3.23.0",
    "@tanstack/vue-query": "^5.100.10",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.4",
    "@vercel/flags-core": "^1.4.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.0",
    "gitleaks-secret-scanner": "^2.1.1",
    "h3": "^1.15.11",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "nuxt": "^4.4.6",
    "posthog-node": "^5.34.4",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^3.2.4",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.0"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "vite": "^7.3.3"
    }
  }
}
